# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment / secrets
.env

# Raw Dataset (internal runtime artifacts)
data/raw/**
!data/raw/.gitkeep

# Non-Data-Service Snapshot output (runtime artifacts)
data/snapshots/**
!data/snapshots/.gitkeep

# Data Service canonical user-facing output (runtime artifacts)
output/**
!output/.gitkeep
