# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend dependencies and build output
web-ui/node_modules/
web-ui/dist/
web-ui/dist-ssr/

# Local editor settings
.vscode/

# Local environment / secrets
.env

# Raw Dataset (internal runtime artifacts)
market-snapshot/data/raw/**
!market-snapshot/data/raw/.gitkeep

# Non-Data-Service Snapshot output (runtime artifacts)
market-snapshot/data/snapshots/**
!market-snapshot/data/snapshots/.gitkeep

# Data Service canonical user-facing output (runtime artifacts)
market-snapshot/output/**
!market-snapshot/output/.gitkeep

# Temporary Documents
_temp_docs/**
!_temp_docs/AGENTS.md
