# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend dependencies and build output
ui_web/node_modules/
ui_web/dist/
ui_web/dist-ssr/

# Local editor settings
.vscode/

# Local environment / secrets
.env

# Raw Dataset (internal runtime artifacts)
data_snapshot/data/raw/**
!data_snapshot/data/raw/.gitkeep

# Daily Market Snapshot output (runtime artifacts)
data_snapshot/data/snapshots/**
!data_snapshot/data/snapshots/.gitkeep

# Research retained outputs (runtime artifacts)
market_research/output/**
!market_research/output/.gitkeep

# Temporary Documents
_temp_docs/**
!_temp_docs/AGENTS.md

# Legacy SQLite caches (left untouched)
data_lake/data/

# Dataset-owned runtime state, including SQLite journals / WAL files
data_lake/datasets/*/data/

# Observation-owned runtime state, including SQLite journals / WAL files
market_research/observations/*/data/
market_research/observations/*/output/

# Experimental runtime artifacts (never formal Dataset state)
data_lake/experiments/**/data/
data_lake/experiments/**/output/
