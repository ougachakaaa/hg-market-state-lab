# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend dependencies and build output
web-ui/node_modules/
web-ui/dist/
web-ui/dist-ssr/

# Local editor settings
.vscode/

# Local environment / secrets
.env

# Raw Dataset (internal runtime artifacts)
market-snapshot/data/raw/**
!market-snapshot/data/raw/.gitkeep

# Daily Market Snapshot output (runtime artifacts)
market-snapshot/data/snapshots/**
!market-snapshot/data/snapshots/.gitkeep

# Research retained outputs (runtime artifacts)
market-research/output/**
!market-research/output/.gitkeep

# Temporary Documents
_temp_docs/**
!_temp_docs/AGENTS.md

# Dataset-owned SQLite caches
data-lake/data/
