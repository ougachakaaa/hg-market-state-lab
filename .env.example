# Repository-local runtime configuration. Copy to .env; never commit .env.
# Process environment variables always override values in .env.
#
# The canonical local file is repository-root .env. Do not create module-local
# .env files: all Python consumers read this file through lab_config.

# Required for Tushare Source I/O.
TUSHARE_TOKEN=

# Optional Tushare request-start limit (integer 1..500). Default: 180.
# TUSHARE_CALLS_PER_MINUTE=180

# Default: local anonymous access on loopback. See ui_http/AUTHENTICATION.md.
# For authenticated local HTTP, set loopback-http and configure the origin and secret.
# The one-click launcher can supply those two settings for explicit loopback-http.
# For deployment, set production explicitly with an HTTPS origin and a secret.
# LAB_AUTH_MODE=local
# LAB_AUTH_ORIGIN=http://127.0.0.1:5173
# LAB_AUTH_JWT_SECRET=

# Optional absolute Auth database path. Default: ui_http/data/auth.sqlite3.
# LAB_AUTH_DB_PATH=

# Optional absolute Publication directory root.
# Active SQLite: publications.sqlite3 inside this root; legacy files are ignored.
# LAB_RESEARCH_PUBLICATION_ROOT=
# Optional absolute Futures Basis directory root (default: ignored Research runtime).
# Active W1 SQLite: runs.sqlite3 inside this root; local filesystem, single backend process.
# LAB_FUTURES_BASIS_RUN_ROOT=

# Optional absolute W2 directory root (default: ignored Backtesting runtime).
# SQLite runs.sqlite3 inside this root; local filesystem, single backend process.
# LAB_BACKTESTING_RUN_ROOT=
