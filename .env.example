# Repository-local runtime configuration. Copy to .env; never commit .env.
# Process environment variables always override values in .env.
#
# The canonical local file is repository-root .env. Do not create module-local
# .env files: all Python consumers read this file through lab_config.

# Required for Tushare Source I/O.
TUSHARE_TOKEN=

# Optional Tushare request-start limit (integer 1..500). Default: 180.
# TUSHARE_CALLS_PER_MINUTE=180

# HTTP Auth is required when serving the backend. See ui_http/AUTHENTICATION.md.
# TUSHARE/DataLake configuration above is not enough to start the authenticated backend.
# LAB_AUTH_JWT_SECRET=
# LAB_AUTH_MODE=loopback-http
# LAB_AUTH_ORIGIN=http://127.0.0.1:5173

# Optional absolute Auth database path. Default: ui_http/data/auth.sqlite3.
# LAB_AUTH_DB_PATH=

# Optional absolute Publication storage root (POSIX-capable runtime required).
# LAB_RESEARCH_PUBLICATION_ROOT=
# Optional absolute Futures Basis online run root (default: ignored Research runtime).
# LAB_FUTURES_BASIS_RUN_ROOT=
