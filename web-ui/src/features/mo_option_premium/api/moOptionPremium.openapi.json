      },
      "PremiumErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/PremiumErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "PremiumErrorResponse",
        "type": "object"
      },
      "PremiumPlaneResponse": {
        "additionalProperties": false,
        "properties": {
          "expiries": {
            "items": {
              "$ref": "#/components/schemas/ExpiryDTO"
            },
            "title": "Expiries",
            "type": "array"
          },
          "observation": {
            "$ref": "#/components/schemas/ObservationDTO"
          },
          "option_product": {
            "$ref": "#/components/schemas/OptionProduct"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/PremiumPointDTO"
            },
            "title": "Points",
            "type": "array"
          },
          "price_type": {
            "$ref": "#/components/schemas/PriceType"
          },
          "underlying": {
            "$ref": "#/components/schemas/UnderlyingDTO"
          }
        },
        "required": [
          "observation",
          "option_product",
          "price_type",
          "underlying",
          "expiries",
          "points"
        ],
        "title": "PremiumPlaneResponse",
        "type": "object"
      },
      "PremiumPointDTO": {
        "additionalProperties": false,
        "properties": {
          "annualized_premium_points": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Annualized Premium Points"
          },
          "annualized_seller_premium_yield": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Annualized Seller Premium Yield"
          },
          "expiry_date": {
            "title": "Expiry Date",
            "type": "string"
          },
