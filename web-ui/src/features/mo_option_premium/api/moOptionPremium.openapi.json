          "price"
        ],
        "title": "FuturesDTO",
        "type": "object"
      },
      "ObservationDTO": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "trade_date",
            "default": "trade_date",
            "title": "Kind",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "title": "ObservationDTO",
        "type": "object"
      },
      "OptionProduct": {
        "enum": [
          "MO"
        ],
        "title": "OptionProduct",
        "type": "string"
      },
      "OptionType": {
        "enum": [
          "call",
          "put"
        ],
        "title": "OptionType",
        "type": "string"
      },
      "PremiumErrorBody": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PremiumErrorKind"
          },
          "param": {
            "anyOf": [
              {
                "enum": [
                  "as_of",
                  "option_product",
                  "price_type"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
