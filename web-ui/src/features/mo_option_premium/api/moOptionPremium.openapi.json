  "info": {
    "summary": "Minimal HTTP delivery adapter for the MO Premium Plane contract.",
    "title": "hg-market-state-lab MO Premium Plane API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/mo-option-premium-plane": {
      "get": {
        "operationId": "readMoOptionPremiumPlane",
        "parameters": [
          {
            "description": "Trade-date observation, YYYY-MM-DD.",
            "in": "query",
            "name": "as_of",
            "required": true,
            "schema": {
              "format": "date",
              "title": "As Of",
              "type": "string"
            }
          },
          {
            "description": "Option product; V1 supports MO only.",
            "in": "query",
            "name": "option_product",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OptionProduct",
              "description": "Option product; V1 supports MO only."
            }
          },
          {
            "description": "Unified selected price semantics.",
            "in": "query",
            "name": "price_type",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/PriceType",
              "default": "close",
              "description": "Unified selected price semantics."
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PremiumPlaneResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PremiumErrorResponse"
                }
              }
            },
            "description": "Invalid or unsupported request."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PremiumErrorResponse"
                }
              }
            },
            "description": "Observation is unavailable."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PremiumErrorResponse"
                }
              }
            },
            "description": "Plane cannot be produced."
          }
        },
        "summary": "Read Mo Option Premium Plane"
      }
    }
  }
}
