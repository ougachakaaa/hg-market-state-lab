          "instrument_id",
          "expiry_date",
          "option_type",
          "strike",
          "premium",
          "annualized_premium_points",
          "annualized_seller_premium_yield"
        ],
        "title": "PremiumPointDTO",
        "type": "object"
      },
      "PriceType": {
        "enum": [
          "open",
          "high",
          "low",
          "close"
        ],
        "title": "PriceType",
        "type": "string"
