            "title": "Instrument Id",
            "type": "string"
          },
          "option_type": {
            "$ref": "#/components/schemas/OptionType"
          },
          "premium": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Premium"
          },
          "strike": {
            "title": "Strike",
            "type": "number"
          }
