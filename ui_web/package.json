{
  "name": "hg-market-state-lab-web-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "contract:generate": "poetry --directory .. run python ui_web/scripts/export_contracts.py && node scripts/contract_types.mjs",
    "contract:check": "poetry --directory .. run python ui_web/scripts/export_contracts.py --check && node scripts/contract_types.mjs --check",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "test:futures-basis-online-browser": "node tests/browser/futures_basis_online_browser.mjs",
    "test:auth-browser": "node tests/browser/auth_browser_smoke.mjs",
    "test:research-browser": "node tests/browser/research_browser_smoke.mjs",
    "test:visualization-browser": "node tests/browser/visualization_browser_smoke.mjs",
    "report:futures-basis": "node scripts/package_futures_basis_report.mjs",
    "test:futures-basis-report-browser": "node tests/browser/futures_basis_report_browser.mjs",
    "test:daily-data-copy-export-browser": "node tests/browser/daily_data_copy_export_browser.mjs",
    "test:backtesting-browser": "node tests/browser/backtesting_browser_acceptance.mjs",
    "demo:build": "node scripts/demo_build_blocked.mjs",
    "test:static-shell": "tsc -p tests/config/tsconfig.shell.json && vite build --config tests/config/vite.shell.config.ts",
    "test:static-shell-browser": "node tests/browser/static_shell_browser.mjs",
    "test:option-chain-static": "tsc -p tests/config/tsconfig.option-chain.json && vite build --config tests/config/vite.option-chain.config.ts",
    "test:option-chain-static-browser": "node tests/browser/option_chain_static_browser.mjs",
    "test:premium-static": "tsc -p tests/config/tsconfig.premium.json && vite build --config tests/config/vite.premium.config.ts",
    "test:premium-static-browser": "node tests/browser/premium_static_browser.mjs",
    "test:catalog-static": "tsc -p tests/config/tsconfig.catalog.json && vite build --config tests/config/vite.catalog.config.ts",
    "test:catalog-static-browser": "node tests/browser/catalog_static_browser.mjs",
    "test:explorer-static": "tsc -p tests/config/tsconfig.explorer.json && vite build --config tests/config/vite.explorer.config.ts",
    "test:explorer-static-browser": "node tests/browser/explorer_static_browser.mjs",
    "test:futures-basis-static": "tsc -p tests/config/tsconfig.futures-basis.json && vite build --config tests/config/vite.futures-basis.config.ts",
    "test:futures-basis-static-browser": "node tests/browser/futures_basis_static_browser.mjs",
    "test:backtesting-static": "tsc -p tests/config/tsconfig.backtesting.json && vite build --config tests/config/vite.backtesting.config.ts",
    "test:backtesting-static-browser": "node tests/browser/backtesting_static_browser.mjs",
    "test:public-safety": "node scripts/public_asset_safety.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "ajv": "^8.20.0",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "plotly.js": "^4.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-plotly.js": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
