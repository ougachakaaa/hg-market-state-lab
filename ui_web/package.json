{
  "name": "hg-market-state-lab-web-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "contract:generate": "poetry --directory .. run python ui_web/scripts/export_contracts.py && node scripts/contract_types.mjs",
    "contract:check": "poetry --directory .. run python ui_web/scripts/export_contracts.py --check && node scripts/contract_types.mjs --check",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "test:auth-browser": "node scripts/auth_browser_smoke.mjs",
    "test:research-browser": "node scripts/research_browser_smoke.mjs",
    "test:visualization-browser": "node scripts/visualization_browser_smoke.mjs",
    "report:futures-basis": "node scripts/package_futures_basis_report.mjs",
    "test:futures-basis-report-browser": "node scripts/futures_basis_report_browser.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "antd": "^6.6.5",
    "plotly.js": "^4.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-plotly.js": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
